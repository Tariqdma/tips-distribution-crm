# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Supabase (primary database, auth, RLS) ---
# The anon key is publishable and safe in the client bundle; RLS is the boundary.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS entirely — never expose to the client,
# never prefix with EXPO_PUBLIC_ or VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- MySQL, used by the legacy tRPC procedures (duty tracking, notifications) ---
# Currently unset in every known environment, which makes server/db.ts fail soft:
# reads return empty, writes throw, and callers degrade silently. Live GPS
# telemetry depends on this. See docs/authorization-model.md.
DATABASE_URL=mysql://user:password@host:3306/database

# --- Transactional email (employee invitations) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- URLs ---
TIPS_CRM_PUBLIC_URL=http://localhost:8081
EXPO_PUBLIC_APP_URL=http://localhost:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
PORT=3000
EXPO_PORT=8081

# --- Legacy OAuth identity path ---
# Authenticates tRPC's ctx.user against the MySQL users table, separately from
# Supabase auth. Scheduled to be retired; see docs/authorization-model.md.
OAUTH_SERVER_URL=
JWT_SECRET=
OWNER_OPEN_ID=

# --- Optional integrations ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_FINANCIAL_SHEET_ID=
